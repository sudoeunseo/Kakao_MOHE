PORT=4000
GEMINI_API_KEY=여기에_발급받은_Gemini_API_키_입력
GEMINI_MODEL=gemini-flash-latest
# URL 직접 접근을 차단하는 쇼핑몰의 대체 분석용 모델
GEMINI_URL_MODEL=gemini-3.5-flash-lite

# 카카오페이 (테스트 모드 — CID는 비워두면 자동으로 TC0ONETIME 사용)
KAKAOPAY_CID=TC0ONETIME
KAKAOPAY_SECRET_KEY=여기에_카카오페이_개발자센터_시크릿키_입력

# 카카오 로그인 (카카오페이 키와 별개)
KAKAO_REST_API_KEY=여기에_카카오_로그인_REST_API_키_입력
KAKAO_CLIENT_SECRET=여기에_카카오_로그인_클라이언트_시크릿_입력
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback
FRONTEND_URL=http://localhost:5173

# Render 단일 배포에서는 아래처럼 같은 도메인을 사용
# KAKAO_REDIRECT_URI=https://kakao-mohe.onrender.com/api/auth/kakao/callback
# FRONTEND_URL=https://kakao-mohe.onrender.com
