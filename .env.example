PORT=4000
GEMINI_API_KEY=여기에_발급받은_Gemini_API_키_입력
GEMINI_MODEL=gemini-flash-latest

# 카카오페이 (테스트 모드 — CID는 비워두면 자동으로 TC0ONETIME 사용)
KAKAOPAY_CID=TC0ONETIME
KAKAOPAY_SECRET_KEY=여기에_카카오페이_개발자센터_시크릿키_입력

# 카카오 로그인 (카카오페이 키와 별개)
KAKAO_REST_API_KEY=여기에_카카오_로그인_REST_API_키_입력
KAKAO_CLIENT_SECRET=여기에_카카오_로그인_클라이언트_시크릿_입력
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback
FRONTEND_URL=http://localhost:5173
